---
import Button from "../components/button.astro";
import SelectedWork from "../components/home/selected-work.astro";
import Separator from "../components/home/separator.astro";
import Layout from "../layouts/main.astro";
import { SITE } from "../site";
---

<Layout>
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-1/2">
        <h1
          class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl dark:text-white"
        >
          Hello, I'm Ahmed.
        </h1>
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
          I'm a mobile engineer in Alexandria, Egypt. I build Android apps, from
          native libraries and device integrations up to the screens people
          use, and I test mobile apps for security.
        </p>
        <p class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200">
          I can help you out with:
        </p>
        <ul
          class="py-2 space-y-[3px] text-sm list-disc list-inside text-neutral-500 dark:text-neutral-400"
        >
          <li>Android engineering (Kotlin, Java)</li>
          <li>Cross-platform apps (React Native, Flutter)</li>
          <li>Mobile app security testing</li>
          <li>Product-minded delivery, from MVP to release</li>
          <li>and more...</li>
        </ul>
        <div class="flex flex-wrap gap-x-3">
          <Button text="Connect on LinkedIn" link={SITE.linkedin} />
          {SITE.cvPdf && <Button text="Download my CV" link={SITE.cvPdf} />}
        </div>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">

          <img
            src="/assets/images/photo2.jpeg"
            alt={`Portrait of ${SITE.name}`}
            loading="eager"
            decoding="auto"
            class="w-full h-auto object-contain object-center rounded-2xl"
          />
        </div>
      </div>
    </div>
  </div>

  <Separator text="Selected work" />
  <SelectedWork />
</Layout>
