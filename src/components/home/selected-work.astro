---
import work from "../../collections/work.json";
import Button from "../button.astro";
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
  >
    Selected Work
  </h2>
  <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
    A few things I've built. Most of this is client or employer code, so there
    is no public repo.
  </p>
  <div class="grid items-stretch w-full grid-cols-1 sm:grid-cols-2 gap-7 mt-7">
    {
      work.map((item) => (
        <div class="relative h-full p-7 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600">
          <p class="text-xs uppercase tracking-widest text-neutral-400 dark:text-neutral-500">
            {item.meta}
          </p>
          <h3 class="mt-1 mb-2 text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
            {item.name}
          </h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">{item.description}</p>
          <ul class="flex flex-wrap gap-2 mt-4">
            {item.tags.map((tag) => (
              <li class="px-2 py-0.5 text-xs rounded-full border border-neutral-200 text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
                {tag}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="flex items-center justify-center w-full py-5">
    <Button text="See my experience" link="/about" />
  </div>
</section>
